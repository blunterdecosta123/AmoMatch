# AmoMatch Environment Configuration
PORT=3001

# Optional: Apify API Token
# If provided, uses official Apify actors (curious_coder/linkedin-profile-scraper and apify/instagram-profile-scraper)
# If omitted or empty, AmoMatch uses its built-in resilient web parsing & OpenGraph metadata scraper engine.
APIFY_API_TOKEN=

# Optional: OpenAI / LLM API Key (if you wish to route custom agent prompting through an external API)
OPENAI_API_KEY=
